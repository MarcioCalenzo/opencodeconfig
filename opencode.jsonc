{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "provider.use", "resource": "devwservices", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
  ],
  "small_model": "google/antigravity-gemini-3.5-flash-lite",
  "provider": {
      "google": {
      "models": {"antigravity-gemini-3.8-flash-low": {"name": "Gemini 3.8 Flash Low (Antigravity)"},  "antigravity-gemini-3.8-flash-medium": {"name": "Gemini 3.8 Flash Medium (Antigravity)"},  "antigravity-gemini-3.8-flash-high": {"name": "Gemini 3.8 Flash High (Antigravity)"},  "antigravity-gemini-3.5-flash-lite": {"name": "Gemini 3.5 Flash Lite (Antigravity)"},  "antigravity-claude-sonnet-4-6": {"name": "Claude Sonnet 4.6 (Antigravity)"},  "antigravity-claude-opus-4-6-thinking": {"name": "Claude Opus 4.6 Thinking (Antigravity)"},  "antigravity-gpt-oss-120b-medium": {"name": "GPT-OSS 120B Medium (Antigravity)"}}
    },
  },
  "agent": {
    "explore": {
      "model": "google/antigravity-gemini-3.8-flash-low",
      "permission": {
        "skill": {
          "*": "deny",
          "documentation-lookup": "allow",
          "search-first": "allow",
          "coding-standards": "allow",
        },
        "doom_loop": "ask",
        "edit": "deny",
        "bash": "deny",
        "grep": "deny",
        "execute": "deny",
        "atlassian_*": "deny",
        "task": { "*": "deny" },
      },
    },
    "scout": {
      "model": "google/antigravity-gemini-3.8-flash-low",
      "permission": {
        "skill": {
          "*": "deny",
          "documentation-lookup": "allow",
          "search-first": "allow",
          "coding-standards": "allow",
        },
        "doom_loop": "ask",
        "edit": "deny",
        "bash": "deny",
        "grep": "deny",
        "execute": "deny",
        "atlassian_*": "deny",
        "task": { "*": "deny" },
      },
    },
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free",
    },
    "build": {
      "model": "opencode/deepseek-v4.1-flash-free",
    },
    "plan": {
      "model": "google/antigravity-gemini-3.8-flash-high",
    },
  },
  "compaction": {
    "auto": false,
    "prune": false,
  },
  "plugins": ["opencode-antigravity-auth@2.1.2", "opencode-gemini-auth@2.0.1"],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "coverage/**",
      "*.lock",
    ],
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git branch -D*": "ask",
      "git push --force*": "deny",
      "git push -f *": "deny",
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials*": "deny",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets/**": "deny",
      "**/credentials*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/.ssh/**": "deny",
      "**/service-account*.json": "deny",
      "**/*.cred": "deny",
    },
    "grep": "allow",
    "question": "allow",
    "glob": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
  },
  "subagent_depth": 3,
  "instructions": [
    "~/.config/opencode/instructions/shell-strategy/shell_strategy.md",
    "~/.config/opencode/prompts/dev-team-core.md",
  ],
  "default_agent": "orchestrator",
  "mcp": {
    "atlassian": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-atlassian@0.23.0"],
      "environment": {
        "JIRA_URL": "https://jira.telefonica.com.br",
        "JIRA_PERSONAL_TOKEN": "{env:JIRA_PAT}",
        "JIRA_SSL_VERIFY": "false",
        "JIRA_PROJECTS_FILTER": "P4P619,MT",
        "TOOLSETS": "default",
      },
    },
  },
}
